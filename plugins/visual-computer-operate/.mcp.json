{
  "mcpServers": {
    "visual-computer-operate": {
      "command": "/usr/bin/python3",
      "args": ["-m", "vco.mcp_server"],
      "cwd": "<path-to-vco-repo>",
      "env": {
        "VCO_MINIMAX_SETTINGS": "<path-to-provider-data>/paper_bentch/data/provider_settings.minimax.json",
        "VCO_GLM_SETTINGS": "<path-to-provider-data>/paper_bentch/data/provider_settings.glm.json",
        "VCO_CACHE_ROOT": "<path-to-vco-repo>/cache"
      }
    }
  }
}
